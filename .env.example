# Copiá este archivo como .env y completá los valores.
# Endpoint del formulario (Formspree: https://formspree.io → New form → copiá el ID)
VITE_FORM_ENDPOINT=https://formspree.io/f/TU_ID_DE_FORMSPREE
# Tamaño máximo del adjunto en MB
VITE_FORM_MAX_MB=10
# Idioma del contenido (archivo src/content/<idioma>.json)
VITE_LANG=es
